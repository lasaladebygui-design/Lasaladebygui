# Copia este archivo como .env y rellena tus valores. Nunca subas .env al repo.

# --- Django -----------------------------------------------------------
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (Supabase Postgres) ---------------------------------
# En Supabase: Project Settings → Database → Connection string → URI
# (usa el modo "Session pooler" o "Transaction pooler" para Render).
# Si se deja vacío, se usa SQLite local automáticamente.
# Formato: postgres://usuario:password@host:puerto/nombre_bd
DATABASE_URL=
DB_SSLMODE=require

# --- Email (verificación de cuenta, contacto, recuperar contraseña) -----
# En desarrollo, deja EMAIL_BACKEND en consola para ver los emails en la terminal.
# En producción (SMTP de Gmail), EMAIL_HOST_PASSWORD debe ser una "contraseña
# de aplicación" (no tu contraseña normal): actívala en Google → Seguridad →
# Verificación en dos pasos → Contraseñas de aplicaciones. Ver README sección 10.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Déjalo vacío: se rellena solo con EMAIL_HOST_USER. IMPORTANTE — Gmail no
# entrega bien los correos si el remitente no coincide con la cuenta que se
# autentica por SMTP, así que no pongas aquí un dominio/email distinto de
# EMAIL_HOST_USER a menos que sea un alias "Enviar como" verificado en esa
# cuenta de Gmail.
DEFAULT_FROM_EMAIL=

# --- Verificación de email opcional ------------------------------------
# Valor inicial para la primera migración; luego se gestiona desde el admin
# (Sitio → Configuración del sitio).
REQUIRE_EMAIL_VERIFICATION=False

# --- Almacenamiento persistente de imágenes (Supabase Storage) ------------
# Opcional pero recomendado en producción: el disco de Render free no es
# persistente (las imágenes subidas desaparecen en cada redeploy). Si rellenas
# esto, avatares/portadas/fotos del tablón se guardan en el Storage de tu
# mismo proyecto de Supabase (API compatible con S3) en vez del disco local.
# Si se deja vacío, se usa el disco local (funciona, pero con esa limitación).
# En Supabase: Storage → Create bucket (marca la casilla "Public") → luego
# Storage → Settings (o Project Settings → Data API) para ver el "S3
# Connection" con el endpoint y la región, y Storage → Settings → S3 Access
# Keys para generar el access key id / secret access key.
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_REGION=us-east-1

# --- APIs de películas (catálogo y ruleta) --------------------------------
# TMDb: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# OMDb (nota IMDb): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# --- Render (se rellena solo en producción) -----------------------------
RENDER_EXTERNAL_HOSTNAME=
